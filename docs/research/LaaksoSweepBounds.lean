import Mathlib.Tactic

/-!
# Finite sweep inequalities for the Laakso gate quotient

This module proves pure real inequalities common to every admissible gate
interval. It does NOT formalize the existence of a gate path, a continuum
quotient metric, or doubling of the density.
-/

namespace LaaksoSweepBounds

/-- Starting at x, ending at y and visiting both endpoints l,u costs
two traversals minus the direct separation. -/
def sweep (l u x y : ℝ) : ℝ :=
  2 * (u - l) - |x - y|

theorem sweep_bounds (l u x y : ℝ)
    (hlx : l ≤ x) (hxu : x ≤ u)
    (hly : l ≤ y) (hyu : y ≤ u) :
    u - l ≤ sweep l u x y ∧ sweep l u x y ≤ 2 * (u - l) := by
  have hxy : |x - y| ≤ u - l := abs_le.mpr ⟨by linarith, by linarith⟩
  constructor
  · dsimp [sweep]
    linarith
  · dsimp [sweep]
    linarith [abs_nonneg (x - y)]

theorem calibrated_sweep_lower (F : ℝ → ℝ) (hF : Monotone F)
    (l u x y : ℝ) (hlx : l ≤ x) (hxu : x ≤ u)
    (hly : l ≤ y) (hyu : y ≤ u) :
    F u - F l ≤ sweep (F l) (F u) (F x) (F y) := by
  exact (sweep_bounds (F l) (F u) (F x) (F y)
    (hF hlx) (hF hxu) (hF hly) (hF hyu)).1

/-- Any admissible interval whose raw sweep cost dominates R is at
least R/2 wide. Hence an R-window at a point x in it lies in the
fivefold concentric dilation of that interval. -/
theorem window_in_fivefold_interval (l u x y R z : ℝ)
    (hlx : l ≤ x) (hxu : x ≤ u)
    (hly : l ≤ y) (hyu : y ≤ u)
    (hcost : R ≤ sweep l u x y)
    (hz : |z - x| ≤ R) :
    |z - (l + u) / 2| ≤ (5 / 2 : ℝ) * (u - l) := by
  have hbound := (sweep_bounds l u x y hlx hxu hly hyu).2
  have hR : R ≤ 2 * (u - l) := le_trans hcost hbound
  obtain ⟨hzlo, hzhi⟩ := abs_le.mp hz
  apply abs_le.mpr
  constructor <;> dsimp <;> linarith


/-- A closed interval ball on the real line. -/
def lineBall (c r : ℝ) : Set ℝ := {z | |z - c| ≤ r}

/-- The quantitative D^3 lower radial comparison at the level of ONE
admissible sweep interval. Unlike an abstract transfer axiom, the proof
explicitly uses the fivefold inclusion and exactly three doubling steps.

The hypotheses on M and F are supplied here: applying the result to the
actual Stieltjes measure on the infinite Laakso quotient remains separate.
-/
theorem radial_mass_le_calibrated_sweep
    (M : Set ℝ → ℝ) (D : ℝ) (hD : 0 ≤ D)
    (hmono : ∀ A B : Set ℝ, A ⊆ B → M A ≤ M B)
    (hdouble : ∀ c r : ℝ, 0 < r →
      M (lineBall c (2 * r)) ≤ D * M (lineBall c r))
    (F : ℝ → ℝ) (hF : Monotone F)
    (l u x y R : ℝ)
    (hl : l < u)
    (hlx : l ≤ x) (hxu : x ≤ u)
    (hly : l ≤ y) (hyu : y ≤ u)
    (hcost : R ≤ sweep l u x y)
    (hinterval : M (lineBall ((l + u) / 2) ((u - l) / 2)) = F u - F l) :
    M (lineBall x R) ≤ D ^ 3 * sweep (F l) (F u) (F x) (F y) := by
  let c : ℝ := (l + u) / 2
  let r : ℝ := (u - l) / 2
  have hr : 0 < r := by dsimp [r]; linarith
  have hsubset : lineBall x R ⊆ lineBall c (8 * r) := by
    intro z hz
    change |z - x| ≤ R at hz
    change |z - c| ≤ 8 * r
    have hw := window_in_fivefold_interval l u x y R z
      hlx hxu hly hyu hcost hz
    dsimp [c, r]
    linarith
  have hiter : M (lineBall c (8 * r)) ≤ D ^ 3 * M (lineBall c r) := by
    calc
      M (lineBall c (8 * r)) =
          M (lineBall c (2 * (4 * r))) := by
            congr 1
            ring
      _ ≤ D * M (lineBall c (4 * r)) :=
        hdouble c (4 * r) (by positivity)
      _ = D * M (lineBall c (2 * (2 * r))) := by
        congr 1
        ring
      _ ≤ D * (D * M (lineBall c (2 * r))) :=
        mul_le_mul_of_nonneg_left
          (hdouble c (2 * r) (by positivity)) hD
      _ ≤ D * (D * (D * M (lineBall c r))) :=
        mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left (hdouble c r hr) hD) hD
      _ = D ^ 3 * M (lineBall c r) := by ring
  have hm : M (lineBall c r) = F u - F l := by
    simpa only [c, r] using hinterval
  calc
    M (lineBall x R) ≤ M (lineBall c (8 * r)) :=
      hmono _ _ hsubset
    _ ≤ D ^ 3 * M (lineBall c r) := hiter
    _ = D ^ 3 * (F u - F l) := by rw [hm]
    _ ≤ D ^ 3 * sweep (F l) (F u) (F x) (F y) :=
      mul_le_mul_of_nonneg_left
        (calibrated_sweep_lower F hF l u x y hlx hxu hly hyu)
        (pow_nonneg hD _)

#print axioms radial_mass_le_calibrated_sweep

#print axioms sweep_bounds
#print axioms calibrated_sweep_lower
#print axioms window_in_fivefold_interval


/-! ## Passing from one admissible interval to the infimum over all intervals

The admissible intervals are an arbitrary nonempty set of endpoint pairs.
No metric, Laakso quotient or compactness premise is hidden in their type.
The proof is an ordered-real infimum argument; the hard remaining bridge
is to identify the actual infinite-quotient distance with this infimum. -/

/-- The set of sweep costs generated by a family of admissible intervals. -/
def sweepCostSet (A : Set (ℝ × ℝ)) (F : ℝ → ℝ) (x y : ℝ) : Set ℝ :=
  {w | ∃ p : ℝ × ℝ, p ∈ A ∧
    w = sweep (F p.1) (F p.2) (F x) (F y)}

/-- Raw sweep distance as the real infimum over the interval family. -/
noncomputable def rawSweepInf (A : Set (ℝ × ℝ)) (x y : ℝ) : ℝ :=
  sInf (sweepCostSet A id x y)

/-- Calibrated sweep distance, with the *same* interval family. -/
noncomputable def calibratedSweepInf (A : Set (ℝ × ℝ)) (F : ℝ → ℝ) (x y : ℝ) : ℝ :=
  sInf (sweepCostSet A F x y)

/-- The D³ mass estimate passes from *each* admissible interval to
the infimum of their calibrated sweep costs. Every hypothesis concerning
the interval family, the mass and its doubling is explicitly present. -/
theorem radial_mass_le_calibrated_infimum
    (A : Set (ℝ × ℝ)) (hA : A.Nonempty)
    (x y : ℝ)
    (hvalid : ∀ p ∈ A, p.1 < p.2 ∧
      p.1 ≤ x ∧ x ≤ p.2 ∧ p.1 ≤ y ∧ y ≤ p.2)
    (M : Set ℝ → ℝ) (D : ℝ) (hD : 0 < D)
    (hmono : ∀ S T : Set ℝ, S ⊆ T → M S ≤ M T)
    (hdouble : ∀ c r : ℝ, 0 < r →
      M (lineBall c (2 * r)) ≤ D * M (lineBall c r))
    (F : ℝ → ℝ) (hF : Monotone F)
    (hinterval : ∀ p ∈ A,
      M (lineBall ((p.1 + p.2) / 2) ((p.2 - p.1) / 2)) =
        F p.2 - F p.1) :
    M (lineBall x (rawSweepInf A x y)) ≤
      D ^ 3 * calibratedSweepInf A F x y := by
  let R := rawSweepInf A x y
  have hrawBdd : BddBelow (sweepCostSet A id x y) := by
    refine ⟨0, ?_⟩
    intro w hw
    rcases hw with ⟨p, hp, rfl⟩
    obtain ⟨hlu, hlx, hxu, hly, hyu⟩ := hvalid p hp
    have h := (sweep_bounds p.1 p.2 x y hlx hxu hly hyu).1
    dsimp at *
    linarith
  have hDpow : 0 < D ^ 3 := pow_pos hD 3
  have hpoint (p : ℝ × ℝ) (hp : p ∈ A) :
      M (lineBall x R) ≤
        D ^ 3 * sweep (F p.1) (F p.2) (F x) (F y) := by
    obtain ⟨hlu, hlx, hxu, hly, hyu⟩ := hvalid p hp
    have hmem : sweep p.1 p.2 x y ∈ sweepCostSet A id x y := by
      exact ⟨p, hp, rfl⟩
    have hR : R ≤ sweep p.1 p.2 x y := by
      exact csInf_le hrawBdd hmem
    exact radial_mass_le_calibrated_sweep
      M D hD.le hmono hdouble F hF p.1 p.2 x y R
      hlu hlx hxu hly hyu hR (hinterval p hp)
  have hcostBdd (w : ℝ) (hw : w ∈ sweepCostSet A F x y) :
      M (lineBall x R) / D ^ 3 ≤ w := by
    rcases hw with ⟨p, hp, rfl⟩
    apply (div_le_iff₀ hDpow).2
    have h := hpoint p hp
    nlinarith
  have hnew : (sweepCostSet A F x y).Nonempty := by
    rcases hA with ⟨p, hp⟩
    exact ⟨_, ⟨p, hp, rfl⟩⟩
  have hInf : M (lineBall x R) / D ^ 3 ≤
      calibratedSweepInf A F x y := by
    exact le_csInf hnew hcostBdd
  have hfin := (div_le_iff₀ hDpow).mp hInf
  dsimp [calibratedSweepInf] at hfin ⊢
  dsimp [R] at hfin ⊢
  nlinarith

#print axioms radial_mass_le_calibrated_infimum

end LaaksoSweepBounds
