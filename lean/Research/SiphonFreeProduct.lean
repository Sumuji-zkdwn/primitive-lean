import Mathlib

/-!
# The siphon operations generate a free product `C₆ * C₂`

`docs/research/2026-11-17-siphon-free-product.md` proves by hand that the polynomial
automorphisms `L(u,v) = (v, v-u)` and `E(u,v) = (u + r², r - (u + r²)³)`, `r = v + u³`, of
the real plane generate a group isomorphic to `C₆ * C₂`, with `a = L` and `b = E L³`
(so `E = b a³`). This module proves it.

* `Lf`, `Ef`, `Bf = E ∘ (-id)` are defined over any commutative ring; `L⁶ = id`
  (`Lperm_pow_six`) and `b² = id` (`Bf_Bf`), so `phi R : C₆ * C₂ →* Perm (R × R)` is
  defined with `Monoid.CoprodI.lift`.
* `phi_poly_injective`: over `R = ℝ[X]` the ping-pong lemma
  (`Monoid.CoprodI.lift_injective_of_ping_pong`) applies. The set for `b` is
  `{E^h z | h ≥ 1, deg z₂ ≤ deg z₁, deg z₁ ≥ 1}`; these points satisfy `deg z₂ = 3 deg z₁`,
  `lc z₁ > 0`, `lc z₂ = -(lc z₁)³` (`EIter_mem_Top`, from the closed form
  `E^h = (u + h r², r - (u + h r²)³)`). The set for `a` is its image under `L, …, L⁵`;
  `L³ = -id` flips the sign of `lc z₁` and the other powers break the degree ratio
  (`Lpow_not_mem_Top`). `b` maps the `a`-set into the `b`-set: after `L³` it merges into
  `E^(h+1)` (`Ef_EIter`), otherwise it starts a new block (`neg_Lpow_mem_Zset`). This is the
  note's "blocks of `E^h` separated by `L^k`, `k ≠ 3`" argument in ping-pong form.
* `phi_real_injective`: the same holds on `ℝ²`. Evaluation at `t ∈ ℝ` commutes with the
  action (`pmap_phi`), and polynomials agreeing at all real points are equal.
* `range_phi`, `freeProductEquiv`: the subgroup of `Perm (ℝ × ℝ)` generated by `L` and `E`
  is isomorphic to `C₆ * C₂`.

The note's exact degree formula `18^m` for reduced words is not formalized here; the
ping-pong argument only needs the leading-term invariants.
-/
namespace SiphonFreeProduct

open scoped Pointwise

variable {R : Type*} [CommRing R]

/-- `L(u,v) = (v, v - u)`. -/
def Lf (z : R × R) : R × R := (z.2, z.2 - z.1)

/-- `r = v + u³`. -/
def rr (z : R × R) : R := z.2 + z.1 ^ 3

/-- `E(u,v) = (u + r², r - (u + r²)³)`. -/
def Ef (z : R × R) : R × R := (z.1 + rr z ^ 2, rr z - (z.1 + rr z ^ 2) ^ 3)

/-- `b = E ∘ L³`, with `L³ = -id`. -/
def Bf (z : R × R) : R × R := Ef (-z.1, -z.2)

theorem Lf_three (z : R × R) : Lf (Lf (Lf z)) = (-z.1, -z.2) := by
  simp only [Lf, Prod.mk.injEq]; constructor <;> ring

theorem Lf_six (z : R × R) : Lf (Lf (Lf (Lf (Lf (Lf z))))) = z := by
  rw [Lf_three, Lf_three]; simp

theorem Bf_Bf (z : R × R) : Bf (Bf z) = z := by
  obtain ⟨u, v⟩ := z
  simp only [Bf, Ef, rr, Prod.mk.injEq]
  constructor <;> ring

def Linv (z : R × R) : R × R := (z.1 - z.2, z.1)

/-- `L` as a permutation of `R × R`. -/
def Lperm (R : Type*) [CommRing R] : Equiv.Perm (R × R) where
  toFun := Lf
  invFun := Linv
  left_inv z := by simp [Lf, Linv]
  right_inv z := by simp [Lf, Linv]

/-- `b` as an involutive permutation of `R × R`. -/
def Bperm (R : Type*) [CommRing R] : Equiv.Perm (R × R) :=
  Function.Involutive.toPerm Bf Bf_Bf

theorem Lperm_apply (z : R × R) : Lperm R z = Lf z := rfl
theorem Bperm_apply (z : R × R) : Bperm R z = Bf z := rfl

theorem Lperm_pow_six : Lperm R ^ 6 = 1 := by
  ext z <;> simp [pow_succ, Equiv.Perm.mul_apply, Lperm_apply, Lf_six]

theorem Bperm_sq : Bperm R ^ 2 = 1 := by
  ext z <;> simp [sq, Equiv.Perm.mul_apply, Bperm_apply, Bf_Bf]

/-- The two generators, indexed by `Bool` (`true ↦ a = L`, `false ↦ b`). -/
def gen (R : Type*) [CommRing R] : Bool → Equiv.Perm (R × R)
  | true => Lperm R
  | false => Bperm R

/-- Their orders `6` and `2`. -/
def ord : Bool → ℕ
  | true => 6
  | false => 2

theorem gen_pow_ord (b : Bool) : gen R b ^ ord b = 1 := by
  cases b
  · exact Bperm_sq
  · exact Lperm_pow_six

/-- The cyclic factors `C₆` and `C₂`. -/
abbrev H (b : Bool) : Type := Multiplicative (ZMod (ord b))

/-- `Multiplicative (ZMod n) →* G` sending the generator to `g` (when `g ^ n = 1`). -/
def cyclicHom {G : Type*} [Group G] (n : ℕ) (g : G) (hg : g ^ n = 1) :
    Multiplicative (ZMod n) →* G :=
  AddMonoidHom.toMultiplicativeLeft
    (ZMod.lift n ⟨zmultiplesHom (Additive G) (Additive.ofMul g), by
      rw [zmultiplesHom_apply, natCast_zsmul, ← ofMul_pow, hg, ofMul_one]⟩)

theorem cyclicHom_apply {G : Type*} [Group G] (n : ℕ) [NeZero n] (g : G) (hg : g ^ n = 1)
    (k : ZMod n) : cyclicHom n g hg (Multiplicative.ofAdd k) = g ^ k.val := by
  have hk : k = ((k.val : ℤ) : ZMod n) := by simp
  show Additive.toMul ((ZMod.lift n _) k) = _
  rw [hk, ZMod.lift_coe, zmultiplesHom_apply, natCast_zsmul, ← ofMul_pow, toMul_ofMul]
  simp

instance (b : Bool) : NeZero (ord b) := by cases b <;> exact ⟨by decide⟩

/-- The homomorphism `C₆ * C₂ → Perm (R × R)`, `a ↦ L`, `b ↦ E ∘ L³`. -/
def phi (R : Type*) [CommRing R] : Monoid.CoprodI H →* Equiv.Perm (R × R) :=
  Monoid.CoprodI.lift fun b => cyclicHom (ord b) (gen R b) (gen_pow_ord b)

/-- Closed form of `E^h`: `(u + h r², r - (u + h r²)³)`. -/
def EIter (h : R) (z : R × R) : R × R := (z.1 + h * rr z ^ 2, rr z - (z.1 + h * rr z ^ 2) ^ 3)

theorem rr_EIter (h : R) (z : R × R) : rr (EIter h z) = rr z := by
  simp only [rr, EIter]; ring

theorem Ef_EIter (h : R) (z : R × R) : Ef (EIter h z) = EIter (h + 1) z := by
  simp only [Ef, rr_EIter]
  simp only [EIter, Prod.mk.injEq]
  constructor <;> ring

theorem EIter_one (z : R × R) : EIter 1 z = Ef z := by
  simp [EIter, Ef]

open Polynomial

/-- Pairs whose first component dominates: `deg u ≥ 1`, `deg v ≤ deg u`. -/
def Zset : Set (ℝ[X] × ℝ[X]) := {z | 1 ≤ z.1.natDegree ∧ z.2.natDegree ≤ z.1.natDegree}

/-- Outputs of positive powers of `E`: `deg v = 3 deg u`, `lc u > 0`, `lc v = -(lc u)³`. -/
def Top : Set (ℝ[X] × ℝ[X]) :=
  {z | 1 ≤ z.1.natDegree ∧ z.2.natDegree = 3 * z.1.natDegree ∧ 0 < z.1.leadingCoeff ∧
    z.2.leadingCoeff = -(z.1.leadingCoeff ^ 3)}

theorem EIter_mem_Top {z : ℝ[X] × ℝ[X]} (hz : z ∈ Zset) {h : ℝ} (hh : 0 < h) :
    EIter (C h) z ∈ Top := by
  obtain ⟨p, q⟩ := z
  obtain ⟨hd, hq⟩ := hz
  simp only at hd hq
  set d := p.natDegree
  have hp0 : p ≠ 0 := by rintro rfl; simp [d] at hd
  -- r = q + p³
  have hp3 : (p ^ 3).natDegree = 3 * d := by rw [natDegree_pow]
  have hr_lt : q.natDegree < (p ^ 3).natDegree := by rw [hp3]; omega
  have hr : (rr (p, q)).natDegree = 3 * d := by
    simp only [rr]; rw [natDegree_add_eq_right_of_natDegree_lt hr_lt, hp3]
  have hrl : (rr (p, q)).leadingCoeff = p.leadingCoeff ^ 3 := by
    simp only [rr]; rw [leadingCoeff_add_of_degree_lt (degree_lt_degree hr_lt), leadingCoeff_pow]
  -- u' = p + h r²
  have hhr : (C h * rr (p, q) ^ 2).natDegree = 6 * d := by
    rw [natDegree_C_mul hh.ne', natDegree_pow, hr]; ring
  have hhrl : (C h * rr (p, q) ^ 2).leadingCoeff = h * p.leadingCoeff ^ 6 := by
    rw [leadingCoeff_C_mul_of_isUnit (isUnit_iff_ne_zero.mpr hh.ne'), leadingCoeff_pow, hrl]; ring
  have hu_lt : p.natDegree < (C h * rr (p, q) ^ 2).natDegree := by rw [hhr]; omega
  have hu : (p + C h * rr (p, q) ^ 2).natDegree = 6 * d := by
    rw [natDegree_add_eq_right_of_natDegree_lt hu_lt, hhr]
  have hul : (p + C h * rr (p, q) ^ 2).leadingCoeff = h * p.leadingCoeff ^ 6 := by
    rw [leadingCoeff_add_of_degree_lt (degree_lt_degree hu_lt), hhrl]
  -- v' = r - u'³
  have hu3 : ((p + C h * rr (p, q) ^ 2) ^ 3).natDegree = 18 * d := by
    rw [natDegree_pow, hu]; ring
  have hv_lt : (rr (p, q)).natDegree < ((p + C h * rr (p, q) ^ 2) ^ 3).natDegree := by
    rw [hu3, hr]; omega
  refine ⟨?_, ?_, ?_, ?_⟩
  · show 1 ≤ (p + C h * rr (p, q) ^ 2).natDegree
    rw [hu]; omega
  · show (rr (p, q) - (p + C h * rr (p, q) ^ 2) ^ 3).natDegree =
      3 * (p + C h * rr (p, q) ^ 2).natDegree
    rw [natDegree_sub_eq_right_of_natDegree_lt hv_lt, hu3, hu]; ring
  · show 0 < (p + C h * rr (p, q) ^ 2).leadingCoeff
    rw [hul]
    exact mul_pos hh ((by decide : Even 6).pow_pos (leadingCoeff_ne_zero.mpr hp0))
  · show (rr (p, q) - (p + C h * rr (p, q) ^ 2) ^ 3).leadingCoeff =
      -((p + C h * rr (p, q) ^ 2).leadingCoeff ^ 3)
    rw [leadingCoeff_sub_of_degree_lt' (degree_lt_degree hv_lt), leadingCoeff_pow]

theorem Lperm_pow_apply (z : R × R) :
    (Lperm R ^ 1) z = (z.2, z.2 - z.1) ∧ (Lperm R ^ 2) z = (z.2 - z.1, -z.1) ∧
    (Lperm R ^ 3) z = (-z.1, -z.2) ∧ (Lperm R ^ 4) z = (-z.2, z.1 - z.2) ∧
    (Lperm R ^ 5) z = (z.1 - z.2, z.1) := by
  obtain ⟨u, v⟩ := z
  simp only [pow_succ, pow_zero, one_mul, Equiv.Perm.mul_apply, Lperm_apply, Lf,
    Prod.mk.injEq, true_and]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> first | (constructor <;> ring) | ring

/-- Degree facts for a point of `Top`. -/
theorem Top_degrees {p q : ℝ[X]} (h : (p, q) ∈ Top) :
    (q - p).natDegree = 3 * p.natDegree ∧ (p - q).natDegree = 3 * p.natDegree ∧
      (-q).natDegree = 3 * p.natDegree ∧ (-p).natDegree = p.natDegree ∧ 1 ≤ p.natDegree := by
  obtain ⟨h1, h2, -, -⟩ := h
  simp only at h1 h2
  have hlt : p.natDegree < q.natDegree := by rw [h2]; omega
  refine ⟨?_, ?_, ?_, natDegree_neg p, h1⟩
  · rw [natDegree_sub_eq_left_of_natDegree_lt hlt, h2]
  · rw [natDegree_sub_eq_right_of_natDegree_lt hlt, h2]
  · rw [natDegree_neg, h2]

theorem Lpow_not_mem_Top {y : ℝ[X] × ℝ[X]} (hy : y ∈ Top) {k : ℕ} (hk1 : 1 ≤ k) (hk5 : k ≤ 5) :
    (Lperm ℝ[X] ^ k) y ∉ Top := by
  obtain ⟨p, q⟩ := y
  obtain ⟨e1, e2, e3, e4, hd⟩ := Top_degrees hy
  obtain ⟨f1, f2, f3, f4, f5⟩ := Lperm_pow_apply (p, q)
  have hq : q.natDegree = 3 * p.natDegree := hy.2.1
  intro hmem
  interval_cases k
  · rw [f1] at hmem; have := hmem.2.1; simp only at this; rw [e1, hq] at this; omega
  · rw [f2] at hmem; have := hmem.2.1; simp only at this; rw [e4, e1] at this; omega
  · rw [f3] at hmem; have := hmem.2.2.1; simp only [leadingCoeff_neg] at this
    linarith [hy.2.2.1]
  · rw [f4] at hmem; have := hmem.2.1; simp only at this; rw [e2, e3] at this; omega
  · rw [f5] at hmem; have := hmem.2.1; simp only at this; rw [e2] at this; omega

/-- Negating `L^k y` (`k ≠ 3`) lands in `Zset`. -/
theorem neg_Lpow_mem_Zset {y : ℝ[X] × ℝ[X]} (hy : y ∈ Top) {k : ℕ} (hk1 : 1 ≤ k) (hk5 : k ≤ 5)
    (hk3 : k ≠ 3) : (-((Lperm ℝ[X] ^ k) y).1, -((Lperm ℝ[X] ^ k) y).2) ∈ Zset := by
  obtain ⟨p, q⟩ := y
  obtain ⟨e1, e2, e3, e4, hd⟩ := Top_degrees hy
  obtain ⟨f1, f2, -, f4, f5⟩ := Lperm_pow_apply (p, q)
  have hq : q.natDegree = 3 * p.natDegree := hy.2.1
  interval_cases k
  · rw [f1]
    refine ⟨?_, ?_⟩
    · show 1 ≤ (-q).natDegree; rw [e3]; omega
    · show (-(q - p)).natDegree ≤ (-q).natDegree; rw [neg_sub, e2, e3]
  · rw [f2]
    refine ⟨?_, ?_⟩
    · show 1 ≤ (-(q - p)).natDegree; rw [neg_sub, e2]; omega
    · show (-(-p)).natDegree ≤ (-(q - p)).natDegree; rw [neg_neg, neg_sub, e2]; omega
  · exact absurd rfl hk3
  · rw [f4]
    refine ⟨?_, ?_⟩
    · show 1 ≤ (-(-q)).natDegree; rw [neg_neg, hq]; omega
    · show (-(p - q)).natDegree ≤ (-(-q)).natDegree; rw [neg_neg, neg_sub, e1, hq]
  · rw [f5]
    refine ⟨?_, ?_⟩
    · show 1 ≤ (-(p - q)).natDegree; rw [neg_sub, e1]; omega
    · show (-p).natDegree ≤ (-(p - q)).natDegree; rw [neg_sub, e4, e1]; omega

/-- Ping-pong set of `b`: the points `E^h z`, `h ≥ 1`, `z ∈ Zset`. -/
def Xb : Set (ℝ[X] × ℝ[X]) := {y | ∃ h : ℕ, 1 ≤ h ∧ ∃ z ∈ Zset, y = EIter (C (h : ℝ)) z}

/-- Ping-pong set of `a`: the images of `Xb` under `L, …, L⁵`. -/
def Xa : Set (ℝ[X] × ℝ[X]) := {y | ∃ k : ℕ, 1 ≤ k ∧ k ≤ 5 ∧ ∃ x ∈ Xb, y = (Lperm ℝ[X] ^ k) x}

theorem Xb_subset_Top : Xb ⊆ Top := by
  rintro _ ⟨h, hh, z, hz, rfl⟩
  exact EIter_mem_Top hz (by exact_mod_cast hh)

theorem Xa_Xb_disjoint : Disjoint Xa Xb := by
  rw [Set.disjoint_left]
  rintro _ ⟨k, hk1, hk5, x, hx, rfl⟩ hb
  exact Lpow_not_mem_Top (Xb_subset_Top hx) hk1 hk5 (Xb_subset_Top hb)

theorem Lpow_maps_Xb {k : ℕ} (hk1 : 1 ≤ k) (hk5 : k ≤ 5) {x : ℝ[X] × ℝ[X]} (hx : x ∈ Xb) :
    (Lperm ℝ[X] ^ k) x ∈ Xa := ⟨k, hk1, hk5, x, hx, rfl⟩

theorem Bperm_maps_Xa {y : ℝ[X] × ℝ[X]} (hy : y ∈ Xa) : Bperm ℝ[X] y ∈ Xb := by
  obtain ⟨k, hk1, hk5, x, ⟨h, hh, z, hz, rfl⟩, rfl⟩ := hy
  rw [Bperm_apply, Bf]
  by_cases hk3 : k = 3
  · subst hk3
    refine ⟨h + 1, by omega, z, hz, ?_⟩
    rw [(Lperm_pow_apply _).2.2.1]
    simp only [neg_neg]
    rw [Ef_EIter, Nat.cast_add, Nat.cast_one, map_add, map_one]
  · refine ⟨1, le_rfl, _, neg_Lpow_mem_Zset
      (EIter_mem_Top hz (show (0 : ℝ) < h by exact_mod_cast hh)) hk1 hk5 hk3, ?_⟩
    rw [Nat.cast_one, map_one, EIter_one]

/-- The ping-pong sets, indexed like the generators. -/
def pp : Bool → Set (ℝ[X] × ℝ[X])
  | true => Xa
  | false => Xb

theorem Xb_nonempty : Xb.Nonempty :=
  ⟨_, 1, le_rfl, (X, 0), ⟨by simp, by simp⟩, rfl⟩

theorem cyclic_val_bounds {n : ℕ} [NeZero n] {k : ZMod n} (hk : k ≠ 0) :
    1 ≤ k.val ∧ k.val < n :=
  ⟨Nat.one_le_iff_ne_zero.mpr ((ZMod.val_ne_zero k).mpr hk), ZMod.val_lt k⟩

/-- **The images of `a = L` and `b = E L³` generate a copy of `C₆ * C₂` in the
permutations of `ℝ[X]²`** (ping-pong). -/
theorem phi_poly_injective : Function.Injective (phi ℝ[X]) := by
  apply Monoid.CoprodI.lift_injective_of_ping_pong (X := pp)
  case hcard =>
    right
    refine ⟨true, ?_⟩
    rw [Cardinal.mk_fintype, Fintype.card_multiplicative, ZMod.card]
    norm_num [ord]
  case hXnonempty =>
    intro i
    cases i
    · exact Xb_nonempty
    · obtain ⟨x, hx⟩ := Xb_nonempty
      exact ⟨_, Lpow_maps_Xb (k := 1) le_rfl (by norm_num) hx⟩
  case hXdisj =>
    intro i j hij
    cases i <;> cases j
    · exact absurd rfl hij
    · exact Xa_Xb_disjoint.symm
    · exact Xa_Xb_disjoint
    · exact absurd rfl hij
  case hpp =>
    intro i j hij h hh
    rw [Set.smul_set_subset_iff]
    intro x hx
    obtain ⟨k, rfl⟩ := Multiplicative.ofAdd.surjective h
    have hk : k ≠ 0 := fun h0 => hh (by rw [h0]; rfl)
    obtain ⟨hk1, hkn⟩ := cyclic_val_bounds hk
    rw [Equiv.Perm.smul_def, cyclicHom_apply]
    cases i <;> cases j
    · exact absurd rfl hij
    · -- `b` maps `Xa` into `Xb`
      have hk2 : k.val = 1 := by have h2 : k.val < 2 := hkn; omega
      rw [hk2, pow_one]
      exact Bperm_maps_Xa hx
    · -- `a^k` maps `Xb` into `Xa`
      have h6 : k.val < 6 := hkn
      exact Lpow_maps_Xb hk1 (by omega) hx
    · exact absurd rfl hij

/-! ## From `ℝ[X]²` to `ℝ²` -/

section Transfer

variable {S : Type*} [CommRing S] (ψ : R →+* S)

/-- Apply a ring homomorphism to both coordinates. -/
def pmap (z : R × R) : S × S := (ψ z.1, ψ z.2)

theorem pmap_Lf (z : R × R) : pmap ψ (Lf z) = Lf (pmap ψ z) := by
  simp [pmap, Lf]

theorem pmap_Bf (z : R × R) : pmap ψ (Bf z) = Bf (pmap ψ z) := by
  simp [pmap, Bf, Ef, rr]

theorem pmap_gen (b : Bool) (z : R × R) : pmap ψ (gen R b z) = gen S b (pmap ψ z) := by
  cases b
  · exact pmap_Bf ψ z
  · exact pmap_Lf ψ z

theorem pmap_gen_pow (b : Bool) (n : ℕ) (z : R × R) :
    pmap ψ ((gen R b ^ n) z) = (gen S b ^ n) (pmap ψ z) := by
  induction n generalizing z with
  | zero => rfl
  | succ n ih =>
    rw [pow_succ, pow_succ, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, ih, pmap_gen]

/-- The action commutes with ring homomorphisms applied coordinatewise. -/
theorem pmap_phi (w : Monoid.CoprodI H) (z : R × R) :
    pmap ψ (phi R w z) = phi S w (pmap ψ z) := by
  induction w using Monoid.CoprodI.induction_on generalizing z with
  | one => rfl
  | of i m =>
    obtain ⟨k, rfl⟩ := Multiplicative.ofAdd.surjective m
    simp only [phi, Monoid.CoprodI.lift_of, cyclicHom_apply]
    exact pmap_gen_pow ψ i k.val z
  | mul x y hx hy => rw [map_mul, map_mul, Equiv.Perm.mul_apply, Equiv.Perm.mul_apply, hx, hy]

end Transfer

/-- **`⟨L, E L³⟩ ≅ C₆ * C₂` on the real plane**: the homomorphism from the free product
`C₆ * C₂` to the permutations of `ℝ²` sending `a ↦ L` and `b ↦ E ∘ L³` is injective. -/
theorem phi_real_injective : Function.Injective (phi ℝ) := by
  rw [injective_iff_map_eq_one]
  intro w hw
  apply phi_poly_injective
  rw [map_one]
  refine Equiv.ext fun z => Prod.ext ?_ ?_
  · apply Polynomial.funext
    intro t
    have := congrArg Prod.fst (pmap_phi (Polynomial.evalRingHom t) w z)
    rw [hw] at this
    exact this
  · apply Polynomial.funext
    intro t
    have := congrArg Prod.snd (pmap_phi (Polynomial.evalRingHom t) w z)
    rw [hw] at this
    exact this

/-- Two elements of `C₆ * C₂` define the same map of `ℝ²` iff they are equal. -/
theorem phi_real_eq_iff (w₁ w₂ : Monoid.CoprodI H) : phi ℝ w₁ = phi ℝ w₂ ↔ w₁ = w₂ :=
  phi_real_injective.eq_iff

/-- `E` as a permutation: `E = b a³`. -/
def Eperm (R : Type*) [CommRing R] : Equiv.Perm (R × R) := Bperm R * Lperm R ^ 3

theorem Eperm_apply (z : R × R) : Eperm R z = Ef z := by
  rw [Eperm, Equiv.Perm.mul_apply, (Lperm_pow_apply z).2.2.1, Bperm_apply, Bf]
  simp

/-- The generator images. -/
theorem phi_of_a : phi R (Monoid.CoprodI.of (i := true) (Multiplicative.ofAdd 1)) = Lperm R := by
  simp only [phi, Monoid.CoprodI.lift_of, cyclicHom_apply]
  rw [show ((1 : ZMod (ord true))).val = 1 from rfl, pow_one]; rfl

theorem phi_of_b : phi R (Monoid.CoprodI.of (i := false) (Multiplicative.ofAdd 1)) = Bperm R := by
  simp only [phi, Monoid.CoprodI.lift_of, cyclicHom_apply]
  rw [show ((1 : ZMod (ord false))).val = 1 from rfl, pow_one]; rfl

/-- The image of `phi` is the group generated by `L` and `E`. -/
theorem range_phi : (phi R).range = Subgroup.closure {Lperm R, Eperm R} := by
  apply le_antisymm
  · rintro _ ⟨w, rfl⟩
    induction w using Monoid.CoprodI.induction_on with
    | one => rw [map_one]; exact Subgroup.one_mem _
    | of i m =>
      obtain ⟨k, rfl⟩ := Multiplicative.ofAdd.surjective m
      simp only [phi, Monoid.CoprodI.lift_of, cyclicHom_apply]
      apply Subgroup.pow_mem
      cases i
      · -- `b = E L⁻³`
        have hB : gen R false = Eperm R * (Lperm R ^ 3)⁻¹ := by
          rw [Eperm, mul_assoc, mul_inv_cancel, mul_one]; rfl
        rw [hB]
        exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
          (Subgroup.inv_mem _ (Subgroup.pow_mem _ (Subgroup.subset_closure (by simp)) _))
      · exact Subgroup.subset_closure (by simp [gen])
    | mul x y hx hy => rw [map_mul]; exact Subgroup.mul_mem _ hx hy
  · rw [Subgroup.closure_le]
    rintro _ (rfl | rfl)
    · exact ⟨_, phi_of_a⟩
    · refine ⟨Monoid.CoprodI.of (i := false) (Multiplicative.ofAdd 1) *
        Monoid.CoprodI.of (i := true) (Multiplicative.ofAdd 1) ^ 3, ?_⟩
      rw [map_mul, map_pow, phi_of_a, phi_of_b]; rfl

/-- **The group of polynomial automorphisms of `ℝ²` generated by `L` and `E` is isomorphic
to the free product `C₆ * C₂`.** -/
noncomputable def freeProductEquiv :
    Monoid.CoprodI H ≃* Subgroup.closure {Lperm ℝ, Eperm ℝ} :=
  (MonoidHom.ofInjective phi_real_injective).trans (MulEquiv.subgroupCongr range_phi)

end SiphonFreeProduct

