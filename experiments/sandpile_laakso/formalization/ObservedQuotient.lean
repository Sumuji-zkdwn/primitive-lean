import Mathlib.Topology.Instances.AddCircle.Real
import Mathlib.Topology.Connected.TotallyDisconnected
import Mathlib.Analysis.SpecialFunctions.Pow.Real
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.MeasureTheory.Integral.Lebesgue.Basic

/-! The observation fibre and the glued set. Heights are centred and rescaled to [-1,1].
The equivalences below descend through the equivalence relation generated by the gate
moves. No identifications at limit heights are inserted in the definition. -/
noncomputable section
namespace ObservedSandpile

abbrev H := Set.Icc (-1 : ℝ) 1
abbrev Bits := ℕ → Bool
abbrev Phase := AddCircle (1 : ℝ)
abbrev Fibre := Phase × Bits

theorem fibre_not_totally_disconnected : ¬ TotallyDisconnectedSpace Fibre := by
  intro h
  letI := h
  let f : Phase → Fibre := fun θ => (θ, fun _ => false)
  have hc : Continuous f := continuous_id.prodMk continuous_const
  have hs : (Set.range f).Subsingleton := (isPreconnected_range hc).subsingleton
  let u : Phase := ((0 : ℝ) : Phase)
  let v : Phase := ((1/2 : ℝ) : Phase)
  have he : u = v := congrArg Prod.fst (hs ⟨u,rfl⟩ ⟨v,rfl⟩)
  have h0 : (0 : ℝ) ∈ Set.Ico (0:ℝ) (0+1) := by constructor <;> norm_num
  have h1 : (1/2 : ℝ) ∈ Set.Ico (0:ℝ) (0+1) := by constructor <;> norm_num
  have hh := (AddCircle.coe_eq_coe_iff_of_mem_Ico h0 h1).mp he
  norm_num at hh

theorem fibre_not_homeomorphic_to_cantor : ¬ Nonempty (Fibre ≃ₜ Bits) := by
  rintro ⟨e⟩
  exact fibre_not_totally_disconnected (e.isEmbedding.isTotallyDisconnected_range.mp
    (isTotallyDisconnected_of_totallyDisconnectedSpace _))

def signedPower (p x : ℝ) : ℝ := if 0 ≤ x then x ^ p else -((-x) ^ p)

private theorem signedPower_inverse (p q : ℝ) (hpq : p*q=1) (x : ℝ) :
    signedPower q (signedPower p x) = x := by
  by_cases hx : 0 ≤ x
  · simp [signedPower, hx, Real.rpow_nonneg hx, ← Real.rpow_mul hx, hpq]
  · have hn : 0 < -x := by linarith
    have hv := Real.rpow_pos_of_pos hn p
    have hh : ¬ 0 ≤ -((-x)^p) := by linarith
    simp [signedPower, hx, hh, ← Real.rpow_mul hn.le, hpq]

private theorem bounds (p : ℝ) (hp : 0 < p) (x : H) :
    signedPower p x.1 ∈ Set.Icc (-1 : ℝ) 1 := by
  obtain ⟨lo,hi⟩ := x.2
  by_cases hx : 0 ≤ x.1
  · have h0 := Real.rpow_nonneg hx p
    have h1 := Real.rpow_le_one hx hi hp.le
    simp only [signedPower, if_pos hx, Set.mem_Icc]
    exact ⟨by linarith, h1⟩
  · have hn : 0 ≤ -x.1 := by linarith
    have h0 := Real.rpow_nonneg hn p
    have h1 := Real.rpow_le_one hn (show -x.1 ≤ 1 by linarith) hp.le
    simp only [signedPower, if_neg hx, Set.mem_Icc]
    constructor <;> linarith

def powerCoordinate (p : ℝ) (hp : 0 < p) : H ≃ H where
  toFun x := ⟨signedPower p x.1, bounds p hp x⟩
  invFun x := ⟨signedPower p⁻¹ x.1, bounds p⁻¹ (inv_pos.mpr hp) x⟩
  left_inv x := Subtype.ext (signedPower_inverse _ _ (mul_inv_cancel₀ hp.ne') x.1)
  right_inv x := Subtype.ext (signedPower_inverse _ _ (inv_mul_cancel₀ hp.ne') x.1)

def ternary (x : H) (k : ℕ) : Prop :=
  ∃ j : ℕ, 0 < j ∧ j < 3^(k+1) ∧ ¬ 3 ∣ j ∧
    x.1 = 2 * (j : ℝ) / 3^(k+1) - 1

def flip (k : ℕ) (b : Bits) : Bits := fun i => if i=k then !(b i) else b i

def gate (G : H → ℕ → Prop) (x y : H × Bits) : Prop :=
  ∃ k, G x.1 k ∧ y = (x.1, flip k x.2)

def liftRel {A C : Type*} (r : A → A → Prop) (x y : A × C) : Prop :=
  r x.1 y.1 ∧ x.2 = y.2

def splitPhase {A C : Type*} (r : A → A → Prop) :
    Quot (liftRel (C := C) r) ≃ Quot r × C where
  toFun := Quot.lift (fun x : A × C => (Quot.mk r x.1, x.2))
    (by intro x y h; exact Prod.ext (Quot.sound h.1) h.2)
  invFun z := Quot.lift (fun a => Quot.mk (liftRel r) (a,z.2))
    (by intro a b h; exact Quot.sound ⟨h,rfl⟩) z.1
  left_inv z := Quot.inductionOn z (fun _ => rfl)
  right_inv z := by
    obtain ⟨q,c⟩ := z
    exact Quot.inductionOn q (fun _ => rfl)

def changeHeight (e : H ≃ H) (G : H → ℕ → Prop) :
    Quot (gate (fun t k => G (e t) k)) ≃ Quot (gate G) where
  toFun := Quot.lift (fun x : H × Bits => Quot.mk _ (e x.1,x.2))
    (by rintro x y ⟨k,h,rfl⟩; exact Quot.sound ⟨k,h,rfl⟩)
  invFun := Quot.lift (fun x : H × Bits => Quot.mk _ (e.symm x.1,x.2))
    (by rintro x y ⟨k,h,rfl⟩; exact Quot.sound ⟨k,by simpa using h,rfl⟩)
  left_inv z := by
    refine Quot.inductionOn z ?_
    rintro ⟨x,b⟩
    change Quot.mk _ (e.symm (e x), b) = Quot.mk _ (x,b)
    rw [e.symm_apply_apply]
  right_inv z := by
    refine Quot.inductionOn z ?_
    rintro ⟨x,b⟩
    change Quot.mk _ (e (e.symm x), b) = Quot.mk _ (x,b)
    rw [e.apply_symm_apply]

/-- The full calibrated quotient with a non-Cantor sandpile phase. -/
def calibratedEquiv (p : ℝ) (hp : 0 < p) :
    Quot (liftRel (C := Phase) (gate (fun t k => ternary (powerCoordinate p hp t) k)))
      ≃ Quot (gate ternary) × Phase :=
  (splitPhase _).trans ((changeHeight _ _).prodCongr (Equiv.refl Phase))

#print axioms fibre_not_homeomorphic_to_cantor
#print axioms calibratedEquiv

/-! A ball average is integrated on a sample space whose law pushes forward to the
observed measure. This avoids choosing representatives of a glued point. Upper
gradients are tested on every 1-Lipschitz parametrisation with real time. Constant
extensions of the usual arc-length parametrisations give the rectifiable-curve test.
On a compact metric space with locally positive finite measure, pairwise mean
oscillation and oscillation about the mean differ by at most a factor of two. -/
open MeasureTheory
open scoped ENNReal

structure Observation (Ω X : Type*) [MeasurableSpace Ω] where
  law : Measure Ω
  readout : Ω → X
  distance : X → X → ℝ
  borelTest : (X → ℝ≥0∞) → Prop

variable {Ω X Y : Type*} [MeasurableSpace Ω]

def Observation.ballIntegral (D : Observation Ω X) (x : X) (r : ℝ) (f : X → ℝ≥0∞) :=
  ∫⁻ w, (if D.distance x (D.readout w) < r then f (D.readout w) else 0) ∂D.law

def Observation.average (D : Observation Ω X) (x : X) (r : ℝ) (f : X → ℝ≥0∞) :=
  D.ballIntegral x r f / D.ballIntegral x r (fun _ => 1)

def TestLip (d : X → X → ℝ) (f : X → ℝ) : Prop :=
  ∃ K : ℝ, 0 ≤ K ∧ ∀ x y, |f x - f y| ≤ K * d x y

def Upper (d : X → X → ℝ) (f : X → ℝ) (g : X → ℝ≥0∞) : Prop :=
  ∀ (T : ℝ), 0 ≤ T → ∀ γ : ℝ → X, (∀ s t, d (γ s) (γ t) ≤ |s-t|) →
    ENNReal.ofReal |f (γ T) - f (γ 0)| ≤ ∫⁻ s in Set.Icc 0 T, g (γ s)

def WeakPI (D : Observation Ω X) : Prop :=
  ∃ C Λ : ℝ, 0 < C ∧ 1 ≤ Λ ∧ ∀ (f : X → ℝ) (g : X → ℝ≥0∞),
    TestLip D.distance f → D.borelTest g → Upper D.distance f g →
    ∀ x r, 0 < r →
      D.average x r (fun u => D.average x r (fun v => ENNReal.ofReal |f u - f v|))
        ≤ ENNReal.ofReal (C*r) * D.average x (Λ*r) g

/-- Radii at most one suffice for these bounded compact spaces. -/
def Regular (D : Observation Ω X) (Q : ℝ) : Prop :=
  ∃ l u : ℝ, 0 < l ∧ 0 < u ∧ ∀ x r, 0 < r → r ≤ 1 →
    ENNReal.ofReal (l * r ^ Q) ≤ D.ballIntegral x r (fun _ => 1) ∧
      D.ballIntegral x r (fun _ => 1) ≤ ENNReal.ofReal (u * r ^ Q)

def reindex (D : Observation Ω Y) (e : X ≃ Y) : Observation Ω X where
  law := D.law
  readout := fun w => e.symm (D.readout w)
  distance := fun x y => D.distance (e x) (e y)
  borelTest := fun g => D.borelTest (fun y => g (e.symm y))

theorem reindex_average (D : Observation Ω Y) (e : X ≃ Y)
    (x : X) (r : ℝ) (f : X → ℝ≥0∞) :
    (reindex D e).average x r f = D.average (e x) r (fun y => f (e.symm y)) := by
  simp [Observation.average, Observation.ballIntegral, reindex]

theorem reindex_PI (D : Observation Ω Y) (e : X ≃ Y) (h : WeakPI D) :
    WeakPI (reindex D e) := by
  obtain ⟨C,L,hC,hL,hpi⟩ := h
  refine ⟨C,L,hC,hL,?_⟩
  intro f g hf hg hu x r hr
  obtain ⟨K,hK,hf⟩ := hf
  have hfl : TestLip D.distance (fun y => f (e.symm y)) := by
    refine ⟨K,hK,fun a b => ?_⟩
    simpa [reindex] using hf (e.symm a) (e.symm b)
  have hul : Upper D.distance (fun y => f (e.symm y)) (fun y => g (e.symm y)) := by
    intro T hT γ hγ
    apply hu T hT (fun s => e.symm (γ s))
    intro s t
    simpa [reindex] using hγ s t
  simpa only [reindex_average] using hpi _ _ hfl hg hul (e x) r hr

theorem reindex_regular (D : Observation Ω Y) (e : X ≃ Y) {Q : ℝ} (h : Regular D Q) :
    Regular (reindex D e) Q := by
  obtain ⟨l,u,hl,hu,Hr⟩ := h
  refine ⟨l,u,hl,hu,fun x r hr h1 => ?_⟩
  simpa [Observation.ballIntegral, reindex] using Hr (e x) r hr h1

/-- A fixed ball with uniformly positive oscillation and arbitrarily small
averaged upper-gradient integral contradicts PI, even allowing a dilated ball. -/
theorem no_PI_of_cut_tests (D : Observation Ω X) (x : X) (r A : ℝ)
    (hr : 0 < r) (hA : 0 < A)
    (cuts : ∀ Λ : ℝ, 1 ≤ Λ → ∀ ε : ℝ, 0 < ε →
      ∃ (f : X → ℝ) (g : X → ℝ≥0∞), TestLip D.distance f ∧ D.borelTest g ∧
        Upper D.distance f g ∧
        ENNReal.ofReal A ≤ D.average x r (fun u => D.average x r
          (fun v => ENNReal.ofReal |f u - f v|)) ∧
        D.average x (Λ*r) g ≤ ENNReal.ofReal ε) : ¬ WeakPI D := by
  rintro ⟨C,Λ,hC,hΛ,pi⟩
  have hCr : 0 < C*r := mul_pos hC hr
  obtain ⟨f,g,hf,hg,hu,hlo,hhi⟩ := cuts Λ hΛ (A/2/(C*r)) (by positivity)
  have h := hlo.trans ((pi f g hf hg hu x r hr).trans (mul_le_mul_right hhi _))
  rw [← ENNReal.ofReal_mul hCr.le] at h
  have ha : C*r*(A/2/(C*r)) = A/2 := by field_simp
  rw [ha] at h
  have hl : A ≤ A/2 := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h
  linarith

/-- Analytic input is the ordinary Laakso-times-circle space with its standard
distance and sample law. The new gauge and its glued set occur in the conclusion. -/
theorem calibrated_PI_and_regular (p : ℝ) (hp : 0 < p)
    (D : Observation Ω (Quot (gate ternary) × Phase)) (Q : ℝ)
    (hpi : WeakPI D) (hQ : Regular D Q) :
    WeakPI (reindex D (calibratedEquiv p hp)) ∧
      Regular (reindex D (calibratedEquiv p hp)) Q ∧
      ¬ Nonempty (Fibre ≃ₜ Bits) :=
  ⟨reindex_PI D _ hpi, reindex_regular D _ hQ, fibre_not_homeomorphic_to_cantor⟩

#print axioms calibrated_PI_and_regular
#print axioms no_PI_of_cut_tests

/-! Operational distance at finite resolution, then the inverse-limit distance.
Cost zero is admitted only for an actual single-digit gate (or a stationary move).
Arbitrary pairs of infinite binary sequences are compared by all finite prefixes. -/
inductive WalkCost {A : Type*} (step : A → A → ℝ≥0∞ → Prop) :
    A → A → ℝ≥0∞ → Prop where
  | stop (x : A) : WalkCost step x x 0
  | next {x y z c d} : step x y c → WalkCost step y z d → WalkCost step x z (c+d)

private theorem mapWalk {A B : Type*} {s : A → A → ℝ≥0∞ → Prop}
    {t : B → B → ℝ≥0∞ → Prop} (f : A → B)
    (hf : ∀ x y c, s x y c → t (f x) (f y) c) {x y c} (h : WalkCost s x y c) :
    WalkCost t (f x) (f y) c := by
  induction h with
  | stop => exact .stop _
  | next h _ ih => exact .next (hf _ _ _ h) ih

def walkDistance {A : Type*} (s : A → A → ℝ≥0∞ → Prop) (x y : A) :=
  sInf {c | WalkCost s x y c}

theorem walkDistance_conjugate {A B : Type*} (e : A ≃ B) (s : B → B → ℝ≥0∞ → Prop) (x y : A) :
    walkDistance (fun u v => s (e u) (e v)) x y = walkDistance s (e x) (e y) := by
  apply congrArg sInf
  ext c
  constructor
  · exact mapWalk e (fun _ _ _ h => h)
  · intro hw
    have hh := mapWalk (s := s) (t := fun u v => s (e u) (e v)) e.symm
      (fun u v k h => by simpa only [e.apply_symm_apply] using h) hw
    simpa using hh

abbrev FiniteState (m : ℕ) := H × (Fin m → Bool) × Phase
def finiteStep (m : ℕ) (x y : FiniteState m) (c : ℝ≥0∞) : Prop :=
  (x.2 = y.2 ∧ c = ENNReal.ofReal |x.1.1-y.1.1|) ∨
  (x.1 = y.1 ∧ x.2.1 = y.2.1 ∧ c = ENNReal.ofReal (dist x.2.2 y.2.2)) ∨
  (x.1 = y.1 ∧ x.2.2 = y.2.2 ∧ c = 0 ∧ ∃ k : Fin m, ternary x.1 k.val ∧
    ∀ i, y.2.1 i = (if i=k then !(x.2.1 i) else x.2.1 i))

def project (m : ℕ) (x : (H × Bits) × Phase) : FiniteState m :=
  (x.1.1, fun k => x.1.2 k.val, x.2)

def relabelFull (e : H ≃ H) (x : (H × Bits) × Phase) : (H × Bits) × Phase :=
  ((e x.1.1, x.1.2), x.2)

def heightLift (m : ℕ) (e : H ≃ H) : FiniteState m ≃ FiniteState m :=
  e.prodCongr (Equiv.refl _)

def limitDistance (e : H ≃ H) (x y : (H × Bits) × Phase) : ℝ≥0∞ :=
  ⨆ m : ℕ, walkDistance
    (fun u v => finiteStep m (heightLift m e u) (heightLift m e v))
    (project m x) (project m y)

theorem limitDistance_eq_standard (p : ℝ) (hp : 0 < p) (x y : (H × Bits) × Phase) :
    limitDistance (powerCoordinate p hp) x y =
      limitDistance (Equiv.refl H) (relabelFull (powerCoordinate p hp) x)
        (relabelFull (powerCoordinate p hp) y) := by
  unfold limitDistance
  apply iSup_congr
  intro m
  rw [walkDistance_conjugate, walkDistance_conjugate]
  rfl

#print axioms limitDistance_eq_standard
end ObservedSandpile
