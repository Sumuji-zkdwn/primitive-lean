/-!
# Reachability, invariants, and compilation of operator languages

Reachability is generated by finite action words. Invariants are
predicates preserved by every primitive action. The elementary
soundness/completeness correspondence states that primitive invariance
is equivalent to closure along all reachable states.

When a new alphabet consists only of compiled old words, it cannot
reach any old-state target that was not already reachable. With a
singleton embedding of each old primitive, the reachability relations
coincide. This complements observational no-new-distinction results
with a genuine state-reachability obstruction.
-/

noncomputable section

namespace LinearInputOperatorReachability

open LinearInputOperatorWords
open LinearInputOperatorRefinement

/-- The reflexive-transitive reachability generated by labelled actions. -/
def Reachable {α ι : Type*} (step : ι → α → α) (x y : α) : Prop :=
  ∃ word : List ι, run step word x = y

/-- A proposition is preserved by each primitive action. -/
def Stable {α ι : Type*}
    (step : ι → α → α) (P : α → Prop) : Prop :=
  ∀ i x, P x → P (step i x)

theorem reachable_refl {α ι : Type*}
    (step : ι → α → α) (x : α) :
    Reachable step x x := by
  exact ⟨[], rfl⟩

theorem reachable_step {α ι : Type*}
    (step : ι → α → α) (i : ι) (x : α) :
    Reachable step x (step i x) := by
  exact ⟨[i], rfl⟩

theorem reachable_word {α ι : Type*}
    (step : ι → α → α) (word : List ι) (x : α) :
    Reachable step x (run step word x) := by
  exact ⟨word, rfl⟩

/-- Concatenating witnesses proves transitivity of reachability. -/
theorem reachable_trans {α ι : Type*}
    (step : ι → α → α) {x y z : α}
    (hxy : Reachable step x y) (hyz : Reachable step y z) :
    Reachable step x z := by
  obtain ⟨w, hw⟩ := hxy
  obtain ⟨v, hv⟩ := hyz
  refine ⟨w ++ v, ?_⟩
  rw [run_append, hw, hv]

theorem reachable_after_action {α ι : Type*}
    (step : ι → α → α) (i : ι) {x y : α}
    (h : Reachable step (step i x) y) :
    Reachable step x y :=
  reachable_trans step (reachable_step step i x) h

theorem reachable_after_word {α ι : Type*}
    (step : ι → α → α) (word : List ι) {x y : α}
    (h : Reachable step (run step word x) y) :
    Reachable step x y :=
  reachable_trans step (reachable_word step word x) h

theorem stable_run {α ι : Type*}
    (step : ι → α → α) (P : α → Prop)
    (hP : Stable step P) (word : List ι)
    {x : α} (hx : P x) :
    P (run step word x) := by
  induction word generalizing x with
  | nil => exact hx
  | cons i tail ih =>
      exact ih (hP i x hx)

/-- A primitive invariant is exactly a reachability-closed predicate. -/
theorem stable_iff_reachable {α ι : Type*}
    (step : ι → α → α) (P : α → Prop) :
    Stable step P ↔ ∀ x y, Reachable step x y → P x → P y := by
  constructor
  · intro hP x y hreach hx
    obtain ⟨word, hw⟩ := hreach
    rw [← hw]
    exact stable_run step P hP word hx
  · intro h i x hx
    exact h x (step i x) (reachable_step step i x) hx

theorem reachable_preserves_invariant {α ι : Type*}
    (step : ι → α → α) (P : α → Prop)
    (hP : Stable step P) {x y : α}
    (hxy : Reachable step x y) (hx : P x) : P y :=
  (stable_iff_reachable step P).1 hP x y hxy hx

/-- The minimal reachable set is the least forward-closed set
containing its starting state. -/
theorem reachable_least_stable {α ι : Type*}
    (step : ι → α → α) (start : α)
    (P : α → Prop) (hP : Stable step P) (hstart : P start)
    {y : α} (hy : Reachable step start y) : P y :=
  reachable_preserves_invariant step P hP hy hstart

theorem stable_true {α ι : Type*}
    (step : ι → α → α) : Stable step (fun _ => True) := by
  intro i x hx
  trivial

theorem stable_false {α ι : Type*}
    (step : ι → α → α) : Stable step (fun _ => False) := by
  intro i x hx
  exact False.elim hx

theorem stable_and {α ι : Type*}
    (step : ι → α → α) (P Q : α → Prop)
    (hP : Stable step P) (hQ : Stable step Q) :
    Stable step (fun x => P x ∧ Q x) := by
  intro i x h
  exact ⟨hP i x h.1, hQ i x h.2⟩

theorem stable_or {α ι : Type*}
    (step : ι → α → α) (P Q : α → Prop)
    (hP : Stable step P) (hQ : Stable step Q) :
    Stable step (fun x => P x ∨ Q x) := by
  intro i x h
  rcases h with hp | hq
  · exact Or.inl (hP i x hp)
  · exact Or.inr (hQ i x hq)

theorem stable_exists {α ι δ : Type*}
    (step : ι → α → α) (P : δ → α → Prop)
    (hP : ∀ d, Stable step (P d)) :
    Stable step (fun x => ∃ d, P d x) := by
  intro i x h
  obtain ⟨d, hd⟩ := h
  exact ⟨d, hP d i x hd⟩

theorem stable_forall {α ι δ : Type*}
    (step : ι → α → α) (P : δ → α → Prop)
    (hP : ∀ d, Stable step (P d)) :
    Stable step (fun x => ∀ d, P d x) := by
  intro i x h d
  exact hP d i x (h d)

theorem invariant_readout_run {α ω ι : Type*}
    (K : α → ω) (step : ι → α → α)
    (hK : ∀ i x, K (step i x) = K x)
    (word : List ι) (x : α) :
    K (run step word x) = K x := by
  induction word generalizing x with
  | nil => rfl
  | cons i tail ih =>
      calc
        K (run step (i :: tail) x) =
            K (run step tail (step i x)) := rfl
        _ = K (step i x) := ih _
        _ = K x := hK i x

/-- Invariant readouts characterize full-word equivalence by the present. -/
theorem invariant_readout_wordEq_iff {α ω ι : Type*}
    (K : α → ω) (step : ι → α → α)
    (hK : ∀ i x, K (step i x) = K x)
    (x y : α) :
    WordEq K step x y ↔ K x = K y := by
  constructor
  · exact word_now
  · intro h word
    calc
      K (run step word x) = K x := invariant_readout_run K step hK word x
      _ = K y := h
      _ = K (run step word y) := (invariant_readout_run K step hK word y).symm

theorem reachable_preserves_readout {α ω ι : Type*}
    (K : α → ω) (step : ι → α → α)
    (hK : ∀ i x, K (step i x) = K x)
    {x y : α} (h : Reachable step x y) : K x = K y := by
  obtain ⟨word, hw⟩ := h
  calc
    K x = K (run step word x) := (invariant_readout_run K step hK word x).symm
    _ = K y := congrArg K hw

/-- Reachability transports through any exact morphism of action systems. -/
theorem reachable_transport {α β ι : Type*}
    (step : ι → α → α) (update : ι → β → β)
    (f : α → β)
    (hf : ∀ i x, f (step i x) = update i (f x))
    {x y : α} (h : Reachable step x y) :
    Reachable update (f x) (f y) := by
  obtain ⟨word,hw⟩ := h
  refine ⟨word, ?_⟩
  rw [← representation_run step update f hf word x, hw]

/-- A compiled generated-language reachability witness is an old witness. -/
theorem generated_reachability_sub {α ι κ : Type*}
    (step : ι → α → α) (code : κ → List ι)
    {x y : α} (h : Reachable (generated step code) x y) :
    Reachable step x y := by
  obtain ⟨word,hw⟩ := h
  refine ⟨compile code word, ?_⟩
  rw [← run_generated step code word x]
  exact hw

/-- A singleton embedding makes all old reachability witnesses portable. -/
theorem old_reachability_of_singletons {α ι κ : Type*}
    (step : ι → α → α) (code : κ → List ι)
    (embed : ι → κ) (he : ∀ i, code (embed i) = [i])
    {x y : α} (h : Reachable step x y) :
    Reachable (generated step code) x y := by
  obtain ⟨word,hw⟩ := h
  refine ⟨word.map embed, ?_⟩
  rw [run_generated, compile_map_singletons code embed he word]
  exact hw

theorem generated_reachability_iff_singletons {α ι κ : Type*}
    (step : ι → α → α) (code : κ → List ι)
    (embed : ι → κ) (he : ∀ i, code (embed i) = [i])
    (x y : α) :
    Reachable (generated step code) x y ↔ Reachable step x y := by
  exact ⟨generated_reachability_sub step code,
    old_reachability_of_singletons step code embed he⟩

/-- Invariants of old primitives remain invariants of generated words. -/
theorem stable_generated {α ι κ : Type*}
    (step : ι → α → α) (code : κ → List ι)
    (P : α → Prop) (hP : Stable step P) :
    Stable (generated step code) P := by
  intro j x hx
  exact stable_run step P hP (code j) hx

/-- Every old reachable state remains reachable after adjoining new actions. -/
theorem extended_reachable_old {α ι κ : Type*}
    (old : ι → α → α) (fresh : κ → α → α)
    {x y : α} (h : Reachable old x y) :
    Reachable (sumStep old fresh) x y := by
  obtain ⟨word,hw⟩ := h
  refine ⟨word.map Sum.inl, ?_⟩
  rw [run_inl]
  exact hw

/-- Adding a primitive that is an old word preserves reachability exactly. -/
theorem generated_extension_reachability {α ι κ : Type*}
    (old : ι → α → α) (code : κ → List ι)
    (x y : α) :
    Reachable (sumStep old (generated old code)) x y ↔
      Reachable old x y := by
  constructor
  · rintro ⟨word,hw⟩
    induction word generalizing x with
    | nil =>
        simpa [run] using (reachable_refl old x)
    | cons tag tail ih =>
        cases tag with
        | inl i =>
            have htail : Reachable old (old i x) y :=
              ih (old i x) (by simpa [run,sumStep] using hw)
            exact reachable_trans old (reachable_step old i x) htail
        | inr j =>
            have htail : Reachable old (run old (code j) x) y :=
              ih (run old (code j) x)
                (by simpa [run,sumStep,generated] using hw)
            exact reachable_trans old
              (reachable_word old (code j) x) htail
  · exact extended_reachable_old old (generated old code)

end LinearInputOperatorReachability
