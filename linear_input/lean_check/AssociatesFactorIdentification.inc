/-!
# Unique factorization as identification modulo units

This generalizes the verified factor-word identification theorems beyond
positive natural numbers. A final product identifies a multiset of
irreducibles only modulo the association relation generated by units.

The full equivalence with a unique-factorization monoid assumes
cancellation away from zero AND existence of irreducible decompositions.
Without these assumptions neither implication is silently asserted.

The arithmetic content of the characterization is provided by pinned
Mathlib UniqueFactorizationMonoid theorems; this file connects it to the
finite-observation and rewrite framework.
-/

noncomputable section

namespace LinearInputAssociatesFactorIdentification

open LinearInputDecompositionIdentification

/-- An atomic word: all factors are irreducible (not just nonunits). -/
def AtomicWord {M : Type*} [CommMonoidWithZero M]
    (w : Multiset M) : Prop :=
  ∀ a ∈ w, Irreducible a

/-- Two factor words agree up to permutation and multiplication of each
factor by an arbitrary unit. This is not literal multiset equality. -/
def AssociatedWords {M : Type*} [CommMonoidWithZero M]
    (u v : Multiset M) : Prop :=
  Multiset.Rel Associated u v

/-- Product evaluation is a single commutative multiplication operation. -/
def evaluation {M : Type*} [CommMonoidWithZero M]
    (u : Multiset M) : M := u.prod

/-- Zero additional observations are needed exactly when the product,
considered up to units, already identifies all atomic words up to units. -/
def ProductIdentifiesAtoms (M : Type*)
    [CommMonoidWithZero M] : Prop :=
  ∀ u v : Multiset M, AtomicWord u → AtomicWord v →
    Associated (evaluation u) (evaluation v) →
      AssociatedWords u v

/-- A finite family of extra probes is evaluated only on factor-word
collisions which the final product cannot distinguish even up to units. -/
def IdentifiesWithUnits {M γ ι : Type*}
    [CommMonoidWithZero M] [DecidableEq ι]
    (probe : ι → Multiset M → γ) (chosen : Finset ι) : Prop :=
  ∀ u v : Multiset M, AtomicWord u → AtomicWord v →
    Associated (evaluation u) (evaluation v) →
    (∀ i ∈ chosen, probe i u = probe i v) →
      AssociatedWords u v

/-- Adding available probes never reduces the identifying ability. -/
theorem probes_mono {M γ ι : Type*}
    [CommMonoidWithZero M] [DecidableEq ι]
    (probe : ι → Multiset M → γ)
    {s t : Finset ι} (hst : s ⊆ t)
    (hs : IdentifiesWithUnits probe s) :
    IdentifiesWithUnits probe t := by
  intro u v hu hv he ht
  exact hs u v hu hv he (by
    intro i hi
    exact ht i (hst hi))

/-- A zero-element permitted probe library needs no extra observer iff
the unit-quotiented final evaluation itself identifies atomic words. -/
theorem zero_probes_iff_product_identifies {M γ ι : Type*}
    [CommMonoidWithZero M] [DecidableEq ι]
    (probe : ι → Multiset M → γ) :
    IdentifiesWithUnits probe ∅ ↔ ProductIdentifiesAtoms M := by
  constructor
  · intro h u v hu hv he
    exact h u v hu hv he (by simp)
  · intro h u v hu hv he _
    exact h u v hu hv he

/-- In a unique factorization monoid, equal products up to units imply
that the irreducible factors agree pairwise up to units. -/
theorem ufm_product_identifies (M : Type*)
    [CommMonoidWithZero M] [UniqueFactorizationMonoid M] :
    ProductIdentifiesAtoms M := by
  intro u v hu hv he
  exact UniqueFactorizationMonoid.factors_unique hu hv he

/-- Therefore a UFM needs no extra probe beyond its final evaluation,
once permutation and units are quotiented out. -/
theorem ufm_zero_extra_probes {M γ ι : Type*}
    [CommMonoidWithZero M] [UniqueFactorizationMonoid M]
    [DecidableEq ι] (probe : ι → Multiset M → γ) :
    IdentifiesWithUnits probe ∅ :=
  (zero_probes_iff_product_identifies probe).2
    (ufm_product_identifies M)

/-- The converse needs existence of atomic decompositions and cancellation
of nonzero factors. These hypotheses are explicit rather than inferred
from commutativity. -/
theorem ufm_iff_product_identifies_of_exists (M : Type*)
    [CommMonoidWithZero M] [IsCancelMulZero M]
    (hexists : ∀ a : M, a ≠ 0 →
      ∃ f : Multiset M, AtomicWord f ∧ Associated f.prod a) :
    UniqueFactorizationMonoid M ↔ ProductIdentifiesAtoms M := by
  constructor
  · intro h
    letI : UniqueFactorizationMonoid M := h
    exact ufm_product_identifies M
  · intro h
    exact UniqueFactorizationMonoid.of_existsUnique_irreducible_factors
      hexists (by
        intro f g hf hg hfg
        exact h f g hf hg hfg)

/-- The traditional irreducible/prime equivalence is a result of the
UFM hypotheses, not merely commutativity. -/
theorem ufm_irreducible_iff_prime {M : Type*}
    [CommMonoidWithZero M] [UniqueFactorizationMonoid M]
    (a : M) : Irreducible a ↔ Prime a :=
  UniqueFactorizationMonoid.irreducible_iff_prime

/-- Every element is associated to any of its unit multiples. -/
theorem unit_multiple_associated {M : Type*}
    [CommMonoidWithZero M] (a : M) (u : Mˣ) :
    Associated a (a * (u : M)) := by
  exact ⟨u, rfl⟩

/-- Modding out by associates makes changes of unit representative
invisible. -/
theorem associates_quotient_forgets_units {M : Type*}
    [CommMonoidWithZero M] (a : M) (u : Mˣ) :
    (Associates.mk (a * (u : M)) : Associates M) =
      Associates.mk a := by
  apply (Associates.mk_eq_mk_iff_associated).2
  exact (unit_multiple_associated a u).symm

/-- An evaluation-preserving rewrite path preserves the final result up
to associates even if each individual rewrite preserves only association. -/
theorem steps_preserve_associated {M : Type*}
    [CommMonoidWithZero M]
    (R : Multiset M → Multiset M → Prop)
    (hstep : ∀ u v, R u v →
      Associated (evaluation u) (evaluation v))
    {u v : Multiset M}
    (h : Steps R u v) :
    Associated (evaluation u) (evaluation v) := by
  induction h with
  | refl x => exact Associated.refl _
  | cons hr _ ih => exact (hstep _ _ hr).trans ih

/-- When a UFM rewrite reaches irreducible words, both endpoints agree
up to factor permutation and units, regardless of the splitting path. -/
theorem ufm_terminal_paths_agree {M : Type*}
    [CommMonoidWithZero M] [UniqueFactorizationMonoid M]
    (R : Multiset M → Multiset M → Prop)
    (hstep : ∀ u v, R u v →
      Associated (evaluation u) (evaluation v))
    {x u v : Multiset M}
    (hxu : Steps R x u) (hxv : Steps R x v)
    (hu : AtomicWord u) (hv : AtomicWord v) :
    AssociatedWords u v := by
  have huval := steps_preserve_associated R hstep hxu
  have hvval := steps_preserve_associated R hstep hxv
  exact (ufm_product_identifies M) u v hu hv (huval.symm.trans hvval)

/-- A single extra observer can separate a collision, but the existence
and cost of such an observer depend on the permitted probe family. -/
theorem collision_requires_nonempty_observation {M γ ι : Type*}
    [CommMonoidWithZero M] [DecidableEq ι]
    (probe : ι → Multiset M → γ)
    (u v : Multiset M)
    (hu : AtomicWord u) (hv : AtomicWord v)
    (he : Associated (evaluation u) (evaluation v))
    (hne : ¬ AssociatedWords u v) :
    ¬ IdentifiesWithUnits probe ∅ := by
  intro h
  exact hne (h u v hu hv he (by simp))

end LinearInputAssociatesFactorIdentification
