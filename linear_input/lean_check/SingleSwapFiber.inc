/-!
All collisions in the 4-6-9 generator-count evaluation are generated by
one oriented swap 4*9 -> 6*6.

For positive generator words w=(r,s,t), value(w)=4^r*6^s*9^t.
Equal values imply the signature equations
  2*r+s = 2*r'+s', s+2*t = s'+2*t'.
Their integer kernel has rank one, generated by (1,-2,1).
The next theorems make the resulting natural-number path explicit:
any two equal-valued generator words are joined in one direction by
a finite chain of the one-step swap.

This concerns the full generator-word representation of the concrete
monoid, not arbitrary monoids with unrelated generators.
-/

namespace LinearInputSingleSwapFiber

open LinearInputHalfFactorial
open LinearInputDecompositionIdentification

/-- Replace exactly one pair of generators 4 and 9 by two 6s. -/
def Swap (u v : Counts) : Prop :=
  u.c4 = v.c4 + 1 ∧ v.c6 = u.c6 + 2 ∧ u.c9 = v.c9 + 1

theorem swap_signature {u v : Counts} (h : Swap u v) :
    signature u = signature v := by
  rcases h with ⟨h4, h6, h9⟩
  apply Prod.ext
  · dsimp [signature]
    omega
  · dsimp [signature]
    omega

theorem swap_preserves_value {u v : Counts} (h : Swap u v) :
    value u = value v := by
  have hs := swap_signature h
  calc
    value u =
      (2 : ℕ) ^ (signature u).1 * 3 ^ (signature u).2 :=
        value_as_prime_powers u
    _ = (2 : ℕ) ^ (signature v).1 * 3 ^ (signature v).2 :=
      congrArg (fun p : ℕ × ℕ => (2 : ℕ) ^ p.1 * 3 ^ p.2) hs
    _ = value v := (value_as_prime_powers v).symm

theorem swap_preserves_length {u v : Counts} (h : Swap u v) :
    length u = length v :=
  same_value_same_length u v (swap_preserves_value h)

theorem swap_decreases_four {u v : Counts} (h : Swap u v) :
    v.c4 < u.c4 := by
  have h4 := h.1
  omega

/-- The permitted one-swap rewrite is terminating. -/
theorem swap_terminates (u : Counts) :
    ∃ v, Steps Swap u v ∧ Terminal Swap v :=
  terminating_normal_form Swap Counts.c4
    (fun h => swap_decreases_four h) u

/-- An oriented swap is possible exactly when both 4 and 9 remain. -/
theorem swap_terminal_iff (u : Counts) :
    Terminal Swap u ↔ u.c4 = 0 ∨ u.c9 = 0 := by
  constructor
  · intro ht
    by_contra hn
    have hp : 0 < u.c4 := by
      by_contra hh
      exact hn (Or.inl (by omega))
    have hq : 0 < u.c9 := by
      by_contra hh
      exact hn (Or.inr (by omega))
    let v : Counts := ⟨u.c4 - 1, u.c6 + 2, u.c9 - 1⟩
    have hs : Swap u v := by
      dsimp [Swap, v]
      constructor
      · omega
      constructor
      · rfl
      · omega
    exact ht v hs
  · intro h v hs
    rcases h with h4 | h9
    · have hh := hs.1
      omega
    · have hh := hs.2.2
      omega

/-- Equal-valued words lie on one ray of the rank-one relation lattice. -/
theorem same_value_parametric (u v : Counts) (h : value u = value v) :
    (∃ k : ℕ, u.c4 = v.c4 + k ∧
      u.c6 + 2 * k = v.c6 ∧ u.c9 = v.c9 + k) ∨
    (∃ k : ℕ, v.c4 = u.c4 + k ∧
      v.c6 + 2 * k = u.c6 ∧ v.c9 = u.c9 + k) := by
  have hs := same_value_same_signature u v h
  have h2 := congrArg Prod.fst hs
  have h3 := congrArg Prod.snd hs
  dsimp [signature] at h2 h3
  by_cases hle : v.c4 ≤ u.c4
  · left
    refine ⟨u.c4 - v.c4, ?_, ?_, ?_⟩ <;> omega
  · right
    refine ⟨v.c4 - u.c4, ?_, ?_, ?_⟩ <;> omega

/-- Each integer kernel displacement can be implemented as exactly k
successive nonnegative generator swaps. -/
theorem k_swaps (k : ℕ) :
    ∀ (u v : Counts),
      u.c4 = v.c4 + k →
      u.c6 + 2 * k = v.c6 →
      u.c9 = v.c9 + k →
      Steps Swap u v := by
  induction k with
  | zero =>
      intro u v h4 h6 h9
      have heq : u = v := by
        cases u with
        | mk a b c =>
          cases v with
          | mk d e f =>
            dsimp at h4 h6 h9
            have ha : a = d := by omega
            have hb : b = e := by omega
            have hc : c = f := by omega
            subst d
            subst e
            subst f
            rfl
      rw [heq]
      exact Steps.refl v
  | succ k ih =>
      intro u v h4 h6 h9
      let w : Counts := ⟨u.c4 - 1, u.c6 + 2, u.c9 - 1⟩
      have hstep : Swap u w := by
        dsimp [Swap, w]
        constructor
        · omega
        constructor
        · rfl
        · omega
      have h4' : w.c4 = v.c4 + k := by
        dsimp [w]
        omega
      have h6' : w.c6 + 2 * k = v.c6 := by
        dsimp [w]
        omega
      have h9' : w.c9 = v.c9 + k := by
        dsimp [w]
        omega
      exact Steps.cons hstep (ih w v h4' h6' h9')

/-- The one relation 4*9 <-> 6*6 generates the whole equality fiber:
for any two words with the same product, one reaches the other by the
oriented swap, possibly in the opposite direction. -/
theorem all_equal_products_connected (u v : Counts)
    (h : value u = value v) :
    Steps Swap u v ∨ Steps Swap v u := by
  rcases same_value_parametric u v h with
    ⟨k, h4, h6, h9⟩ | ⟨k, h4, h6, h9⟩
  · exact Or.inl (k_swaps k u v h4 h6 h9)
  · exact Or.inr (k_swaps k v u h4 h6 h9)

/-- On a fixed product, two terminal normal forms under the oriented
swap coincide, even though the original factorization is nonunique. -/
theorem equal_product_terminal_unique (u v : Counts)
    (h : value u = value v)
    (htu : Terminal Swap u) (htv : Terminal Swap v) : u = v := by
  rcases all_equal_products_connected u v h with hpath | hpath
  · exact terminal_path_eq htu hpath
  · exact (terminal_path_eq htv hpath).symm

end LinearInputSingleSwapFiber
