/-!
# Rational-function extension degree for the generic Chebyshev quotient

For a natural number m, the rational function (X^(2m)+1)/X^m
is the unnormalised Chebyshev quotient z^m+z^(-m).
The normalized target t differs by a nonzero constant factor 2.

The independent fixed-toolchain probe passed; this source is now registered
for full-tree Lean compilation and all-declaration axiom auditing.
-/
noncomputable section

namespace LinearInputChebyshevTower

open Polynomial
open IntermediateField

def quotientNumerator (m : ℕ) : Polynomial ℂ :=
  X ^ (2 * m) + 1

def quotientDenominator (m : ℕ) : Polynomial ℂ :=
  X ^ m

def genericQuotient (m : ℕ) : RatFunc ℂ :=
  algebraMap (Polynomial ℂ) (RatFunc ℂ) (quotientNumerator m) /
    algebraMap (Polynomial ℂ) (RatFunc ℂ) (quotientDenominator m)

/-- Explicit Bezout certificate. -/
theorem numerator_sub_denominator_sq (m : ℕ) :
    quotientNumerator m -
      quotientDenominator m * quotientDenominator m = 1 := by
  unfold quotientNumerator quotientDenominator
  rw [show 2 * m = m * 2 by omega, pow_mul]
  ring

theorem quotientDenominator_ne_zero (m : ℕ) :
    quotientDenominator m ≠ 0 := by
  unfold quotientDenominator
  exact pow_ne_zero _ (by simp)

theorem numerator_denominator_isCoprime (m : ℕ) :
    IsCoprime (quotientNumerator m) (quotientDenominator m) := by
  refine ⟨1, -(quotientDenominator m), ?_⟩
  calc
    (1 : Polynomial ℂ) * quotientNumerator m +
        -(quotientDenominator m) * quotientDenominator m =
      quotientNumerator m - quotientDenominator m * quotientDenominator m := by ring
    _ = 1 := numerator_sub_denominator_sq m

theorem quotient_gcd_one (m : ℕ) :
    GCDMonoid.gcd (quotientNumerator m) (quotientDenominator m) = 1 := by
  have hdiv : GCDMonoid.gcd (quotientNumerator m) (quotientDenominator m) ∣
      (1 : Polynomial ℂ) := by
    rw [← numerator_sub_denominator_sq m]
    exact dvd_sub
      (GCDMonoid.gcd_dvd_left _ _)
      (dvd_mul_of_dvd_left (GCDMonoid.gcd_dvd_right _ _) _)
  have hunit : IsUnit (GCDMonoid.gcd (quotientNumerator m) (quotientDenominator m)) :=
    isUnit_of_dvd_one hdiv
  have hn : normalize (GCDMonoid.gcd (quotientNumerator m) (quotientDenominator m)) = 1 :=
    (normalize_eq_one).2 hunit
  simpa only [NormalizedGCDMonoid.normalize_gcd] using hn

theorem quotient_num (m : ℕ) :
    (genericQuotient m).num = quotientNumerator m := by
  unfold genericQuotient
  rw [RatFunc.num_div, quotient_gcd_one]
  simp [quotientDenominator]

theorem quotient_denom (m : ℕ) :
    (genericQuotient m).denom = quotientDenominator m := by
  unfold genericQuotient
  rw [RatFunc.denom_div _ (quotientDenominator_ne_zero m), quotient_gcd_one]
  simp [quotientDenominator]

theorem finrank_genericQuotient (m : ℕ) :
    Module.finrank ℂ⟮genericQuotient m⟯ (RatFunc ℂ) = 2 * m := by
  calc
    Module.finrank ℂ⟮genericQuotient m⟯ (RatFunc ℂ) =
        max (genericQuotient m).num.natDegree
            (genericQuotient m).denom.natDegree :=
      RatFunc.finrank_eq_max_natDegree (genericQuotient m)
    _ = 2 * m := by
      rw [quotient_num, quotient_denom]
      have hn : (quotientNumerator m).natDegree = 2 * m := by
        by_cases hm : m = 0
        · subst m
          norm_num [quotientNumerator]
        · have hpos : 0 < 2 * m := by omega
          have hlt :
              (1 : Polynomial ℂ).natDegree <
                ((X : Polynomial ℂ) ^ (2 * m)).natDegree := by
            simpa using hpos
          unfold quotientNumerator
          rw [natDegree_add_eq_left_of_natDegree_lt hlt]
          simp
      have hd : (quotientDenominator m).natDegree = m := by
        simp [quotientDenominator]
      rw [hn, hd]
      omega


/-- The usual Chebyshev coordinate is half of the monic-denominator quotient. -/
def genericParameter (m : ℕ) : RatFunc ℂ :=
  genericQuotient m / 2

/-- Multiplication by a nonzero constant in the coefficient field does not
change the subfield generated by a rational function. -/
theorem adjoin_half_eq (h : RatFunc ℂ) :
    IntermediateField.adjoin ℂ ({h / 2} : Set (RatFunc ℂ)) =
      IntermediateField.adjoin ℂ ({h} : Set (RatFunc ℂ)) := by
  let A : IntermediateField ℂ (RatFunc ℂ) :=
    IntermediateField.adjoin ℂ ({h / 2} : Set (RatFunc ℂ))
  let B : IntermediateField ℂ (RatFunc ℂ) :=
    IntermediateField.adjoin ℂ ({h} : Set (RatFunc ℂ))
  have hhalfA : h / 2 ∈ A :=
    IntermediateField.subset_adjoin ℂ _ (by simp)
  have hB : h ∈ B :=
    IntermediateField.subset_adjoin ℂ _ (by simp)
  have htwoA : (2 : RatFunc ℂ) ∈ A := A.natCast_mem 2
  have htwoB : (2 : RatFunc ℂ) ∈ B := B.natCast_mem 2
  have hhA : h ∈ A := by
    have hc : h / (2 : RatFunc ℂ) * 2 = h := by
      field_simp
    rw [← hc]
    exact A.mul_mem hhalfA htwoA
  have hhalfB : h / 2 ∈ B := B.div_mem hB htwoB
  change A = B
  apply le_antisymm
  · refine (IntermediateField.adjoin_le_iff).2 ?_
    intro y hy
    have hy' : y = h / 2 := by simpa using hy
    simpa [hy'] using hhalfB
  · refine (IntermediateField.adjoin_le_iff).2 ?_
    intro y hy
    have hy' : y = h := by simpa using hy
    simpa [hy'] using hhA

/-- Exact extension degree for the usual half-normalized parameter. -/
theorem finrank_genericParameter (m : ℕ) :
    Module.finrank ℂ⟮genericParameter m⟯ (RatFunc ℂ) = 2 * m := by
  change Module.finrank
    (IntermediateField.adjoin ℂ
      ({genericQuotient m / 2} : Set (RatFunc ℂ))) (RatFunc ℂ) = 2 * m
  rw [adjoin_half_eq]
  exact finrank_genericQuotient m

/-- The quotient is the usual z^m + z^(-m). -/
theorem genericQuotient_eq_pow_add_inv (m : ℕ) :
    genericQuotient m =
      (RatFunc.X : RatFunc ℂ) ^ m +
        ((RatFunc.X : RatFunc ℂ) ^ m)⁻¹ := by
  have hx : (RatFunc.X : RatFunc ℂ) ^ m ≠ 0 :=
    pow_ne_zero _ RatFunc.X_ne_zero
  unfold genericQuotient quotientNumerator quotientDenominator
  simp only [map_add, map_pow, map_one, RatFunc.algebraMap_X]
  rw [show 2 * m = m * 2 by omega, pow_mul]
  field_simp [hx]

theorem genericParameter_eq_joukowski (m : ℕ) :
    genericParameter m =
      LinearInputChebyshevDescent.joukowski
        ((RatFunc.X : RatFunc ℂ) ^ m) := by
  unfold genericParameter LinearInputChebyshevDescent.joukowski
  rw [genericQuotient_eq_pow_add_inv]

end LinearInputChebyshevTower
