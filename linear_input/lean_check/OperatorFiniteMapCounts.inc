/-!
# Finite compatible-map counts: a concrete three-state certificate

For the observer with fibers {0,1} and {2}, compatible endomorphisms
must send 0 and 1 into the same output class. This property is exactly
the F0 fiber-stability / semantic operator-compatibility condition.

There are fifteen such maps out of the 27 possible maps on Fin 3.
The class-level endomorphism actions are fewer still, because raw
compatible maps can agree on the quotient despite differing internally.

The numerical facts are kernel-reduced finite proofs; an arbitrary
finite-partition product formula is documented and separately enumerated,
but is not asserted as a Lean theorem here.
-/

noncomputable section

namespace LinearInputOperatorFiniteCounts

open LinearInputOperatorWords
open LinearInputOperatorSemanticClosure
open LinearInputOperatorF0Bridge

/-- The three-state observer with two initial observation fibers. -/
def observedThree : Fin 3 → Fin 2 := exampleK

/-- The whole finite space of raw three-state operators. -/
def allRawThree : Finset (Fin 3 → Fin 3) := Finset.univ

/-- Operator candidates preserving the two initial observation classes. -/
def eligibleThree : Finset (Fin 3 → Fin 3) :=
  Finset.univ.filter (fun T => observedThree (T 0) = observedThree (T 1))

/-- The syntactic eligibility criterion is just a two-point fiber test. -/
theorem eligible_iff (T : Fin 3 → Fin 3) :
    T ∈ eligibleThree ↔ observedThree (T 0) = observedThree (T 1) := by
  simp [eligibleThree]

/-- The identity raw transformer preserves the old observation partition. -/
theorem identity_eligible :
    (fun x : Fin 3 => x) ∈ eligibleThree := by
  decide

/-- Constant-to-2 is eligible although not generated by identity words. -/
theorem constantTwo_eligible :
    constantTwo ∈ eligibleThree := by
  decide

/-- Every constant raw transformer preserves the two-class observer. -/
theorem constant_eligible (c : Fin 3) :
    (fun _ : Fin 3 => c) ∈ eligibleThree := by
  simp [eligibleThree]

/-- Exact count of all raw three-state maps. -/
theorem total_raw_three_count : allRawThree.card = 27 := by
  decide

/-- Exactly 15 raw maps are compatible with the partition 2+1. -/
theorem compatible_raw_three_count : eligibleThree.card = 15 := by
  decide

/-- The compatibility requirement is not vacuous. -/
theorem compatible_raw_three_strict :
    eligibleThree.card < allRawThree.card := by
  rw [compatible_raw_three_count, total_raw_three_count]
  omega

/-- Semantic compatibility over the identity-only language is equivalent
to the old present-time fiber condition. -/
theorem base_semantic_iff_fiber (T : Fin 3 → Fin 3) :
    Compatible exampleK baseStep T ↔ FiberStable exampleK T := by
  apply compatible_iff_fiber_stable exampleK baseStep
  intro i x y h
  simpa [baseStep] using h

/-- The constant-to-two raw operator is not an old-language word,
not even after quotienting by observational indistinguishability. -/
theorem count_witness_not_generated (word : List Unit) :
    ¬ ∀ x : Fin 3,
      encode exampleK baseStep (run baseStep word x) =
        encode exampleK baseStep (constantTwo x) :=
  constantTwo_not_old_word_mod_observation word

/-- There exist eligible raw operators outside the identity-only word language. -/
theorem eligible_not_word_generated :
    ∃ T : Fin 3 → Fin 3,
      T ∈ eligibleThree ∧
      ∀ word : List Unit,
        ¬ ∀ x : Fin 3,
          encode exampleK baseStep (run baseStep word x) =
            encode exampleK baseStep (T x) := by
  exact ⟨constantTwo, constantTwo_eligible,
    fun word => count_witness_not_generated word⟩

end LinearInputOperatorFiniteCounts
