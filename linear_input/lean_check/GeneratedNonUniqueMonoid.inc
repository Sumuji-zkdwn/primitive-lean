/-!
# A cancellative commutative monoid with nonunique atomic factorizations

Take the multiplicative submonoid of natural numbers generated by 4, 6, 9.
Its elements are 1 or at least 4. Thus 4, 6, and 9 are indivisible
into products of two nonunits *inside this submonoid*, even though they
are composite integers in the ambient natural numbers.

But 4 * 9 = 6 * 6. The element 6 is atomic but fails Euclid's prime
divisibility condition relative to this monoid.

These are facts about an actual submonoid, not merely distinct labels
in a free generator multiset. "Atomic" and "prime" are explicitly defined
below relative to the submonoid; no identification with a general
zero-containing UFD structure is assumed.
-/

noncomputable section

namespace LinearInputGeneratedNonUnique

/-- Exactly the three allowed atomic generators. -/
def generatorSet : Set ℕ := {4, 6, 9}

/-- The commutative monoid generated under ordinary multiplication. -/
def generated : Submonoid ℕ := Submonoid.closure generatorSet

abbrev G := generated

def four : G := ⟨4, Submonoid.mem_closure_of_mem (by simp [generatorSet])⟩
def six : G := ⟨6, Submonoid.mem_closure_of_mem (by simp [generatorSet])⟩
def nine : G := ⟨9, Submonoid.mem_closure_of_mem (by simp [generatorSet])⟩

/-- No element between 1 and 4 belongs to the generated monoid. -/
theorem one_or_at_least_four (x : G) :
    x.val = 1 ∨ 4 ≤ x.val := by
  refine Submonoid.closure_induction (s := generatorSet)
    (motive := fun n _ => n = 1 ∨ 4 ≤ n) ?_ ?_ ?_ x.property
  · intro n hn
    simp only [generatorSet, Set.mem_insert_iff,
      Set.mem_singleton_iff] at hn
    rcases hn with rfl | rfl | rfl <;> omega
  · exact Or.inl rfl
  · intro a b ha hb hA hB
    rcases hA with h1 | h4
    · subst a
      simpa only [one_mul] using hB
    rcases hB with h1 | h4'
    · subst b
      simpa only [mul_one] using (Or.inr h4)
    · right
      nlinarith

/-- In particular all elements are positive (none is the absorbing zero). -/
theorem member_positive (x : G) : 0 < x.val := by
  rcases one_or_at_least_four x with h | h <;> omega

/-- A relative atom cannot be expressed as a product of two nonunits.
The only unit in this positive submonoid is the element 1. -/
def Atomic (x : G) : Prop :=
  x.val ≠ 1 ∧
    ∀ a b : G, a * b = x → a.val = 1 ∨ b.val = 1

/-- Elements smaller than 16 but different from 1 are atomic. -/
theorem small_is_atomic (x : G) (hne : x.val ≠ 1)
    (hlt : x.val < 16) : Atomic x := by
  refine ⟨hne, ?_⟩
  intro a b hab
  have heq : a.val * b.val = x.val := congrArg Subtype.val hab
  rcases one_or_at_least_four a with ha | ha
  · exact Or.inl ha
  rcases one_or_at_least_four b with hb | hb
  · exact Or.inr hb
  have hlarge : 16 ≤ a.val * b.val := by nlinarith
  omega

theorem four_atomic : Atomic four :=
  small_is_atomic four (by decide) (by decide)

theorem six_atomic : Atomic six :=
  small_is_atomic six (by decide) (by decide)

theorem nine_atomic : Atomic nine :=
  small_is_atomic nine (by decide) (by decide)

/-- The distinct irreducible factorizations of 36. -/
theorem four_nine_eq_six_six : four * nine = six * six := by
  apply Subtype.ext
  norm_num [four, six, nine]

/-- All four factors are atoms in the generated monoid. -/
theorem nonunique_atomic_factorization :
    Atomic four ∧ Atomic nine ∧ Atomic six ∧
      four * nine = six * six :=
  ⟨four_atomic, nine_atomic, six_atomic, four_nine_eq_six_six⟩

/-- Divisibility and primality are always understood inside G. -/
def Divides (a b : G) : Prop := ∃ c : G, a * c = b

def Primal (p : G) : Prop :=
  p.val ≠ 1 ∧
    ∀ a b : G, Divides p (a * b) →
      Divides p a ∨ Divides p b

theorem six_dvd_four_times_nine :
    Divides six (four * nine) := by
  refine ⟨six, ?_⟩
  exact four_nine_eq_six_six.symm

theorem six_not_dvd_four : ¬ Divides six four := by
  rintro ⟨c, hc⟩
  have heq : (6 : ℕ) * c.val = 4 := by
    have h := congrArg Subtype.val hc
    simpa [six, four] using h
  have hpos : 0 < c.val := member_positive c
  omega

theorem six_not_dvd_nine : ¬ Divides six nine := by
  rintro ⟨c, hc⟩
  have heq : (6 : ℕ) * c.val = 9 := by
    have h := congrArg Subtype.val hc
    simpa [six, nine] using h
  omega

/-- The relative atom 6 is not prime: it divides 4*9, yet divides
neither 4 nor 9 in this cancellative commutative submonoid. -/
theorem six_not_primal : ¬ Primal six := by
  intro hp
  rcases hp.2 four nine six_dvd_four_times_nine with h | h
  · exact six_not_dvd_four h
  · exact six_not_dvd_nine h

/-- Explicit collision at the level of multisets of actual monoid
elements, not just labels. -/
def word49 : Multiset G := four ::ₘ nine ::ₘ 0
def word66 : Multiset G := six ::ₘ six ::ₘ 0

theorem word_products_collide :
    word49.prod = word66.prod := by
  simpa [word49, word66, Multiset.prod_cons] using
    four_nine_eq_six_six

theorem words_distinct : word49 ≠ word66 := by
  classical
  intro heq
  have hm := congrArg
    (fun w : Multiset G => (w.map (fun x : G => x.val)).count 4) heq
  norm_num [word49, word66, four, six, nine] at hm

/-- Atomic factors and equal product do not imply unique words. -/
theorem actual_nonunique_factor_words :
    word49.prod = word66.prod ∧ word49 ≠ word66 :=
  ⟨word_products_collide, words_distinct⟩


/-- Two different actual atomic words treated as a finite identification task. -/
def candidate (i : Fin 2) : Multiset G :=
  if i.val = 0 then word49 else word66

def candidateProduct (i : Fin 2) : G := (candidate i).prod

/-- The permitted probe counts occurrences of the actual element 4. -/
def probeFour (i : Fin 2) : ℕ :=
  ((candidate i).map (fun a : G => a.val)).count 4

/-- The product alone cannot tell the two candidate words apart. -/
theorem candidate_product_not_injective :
    ¬ Function.Injective candidateProduct := by
  intro hinj
  have he : candidateProduct 0 = candidateProduct 1 := by
    simpa [candidateProduct, candidate] using word_products_collide
  have hbad : (0 : Fin 2) = 1 := hinj he
  exact (by decide : (0 : Fin 2) ≠ 1) hbad

/-- A single permitted count observation distinguishes both candidates. -/
theorem probe_four_injective :
    Function.Injective probeFour := by
  intro i j he
  fin_cases i <;> fin_cases j <;>
    simp_all [probeFour, candidate, word49, word66, four, six, nine]

/-- Exactly zero extra probes fail, while one additional count
observation succeeds. This refers only to the two candidate words,
not to every possible factor word in the infinite monoid. -/
theorem one_extra_probe_on_two_words :
    ¬ Function.Injective candidateProduct ∧
    Function.Injective (fun i : Fin 2 =>
      (candidateProduct i, probeFour i)) := by
  constructor
  · exact candidate_product_not_injective
  · intro i j h
    exact probe_four_injective (congrArg Prod.snd h)

end LinearInputGeneratedNonUnique
